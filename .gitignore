# build / cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
pytest-cache-files-*/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# venv
.venv/
venv/

# data / logs / reports (do not commit)
# NOTE: anchored to repo root so the src/tickweaver/data/ source package is
# NOT ignored (previously a bare `data/` rule hid the whole module from git).
/data/
logs/
reports/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# env
.env
.env.local

# plan / design notes
plans/
plan.md
plan_viz.md

!test_strategy/short_demo.py
!test_strategy/future_demo.py

# private strategy (Vulture) — kept local only, never committed
test_strategy/vulture.py
configs/vulture.yaml

# diagnostic logs from `--viz 2> ...log` redirect
*_diag.log
vulture_diag.log

# local dev artifacts (goal specs, viz CSV exports, smoke run outputs)
goals/
positions_history/
runs/

# agent / team local state (Claude Code teams, tasks, worktrees)
.claude/

# parity: real TradingView exports dropped into reference/ are user data — keep
# only the committed *.sample.csv fixtures. (The evidence CSVs backing
# parity/RESULTS.md live in parity/ root and ARE committed.)
parity/reference/*.csv
!parity/reference/*.sample.csv
